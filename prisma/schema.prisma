// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyType {
  HOUSE
  CONDO
  APARTMENT
  DORMITORY
  OTHER
}

enum RentType {
  INDIVIDUAL_ROOM
  WHOLE_UNIT
}

enum PublishStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  CLOSED
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  RENTED
}

enum CommunityPostStatus {
  OPEN
  FULL
  CLOSED
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CommunityMemberRole {
  CREATOR
  MEMBER
}

enum RentalStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  email     String     @unique
  password  String
  role      Role       @default(USER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  profile Profile?

  ownerApplications    OwnerApplication[] @relation("OwnerApplicationUser")
  reviewedApplications OwnerApplication[] @relation("OwnerApplicationReviewer")

  properties Property[]

  communityPosts   CommunityPost[]
  joinRequests     JoinRequest[]
  communityMembers CommunityMember[]

  conversationMembers ConversationMember[]
  messages            Message[]

  ownedRentals  Rental[]       @relation("RentalOwner")
  rentalMembers RentalMember[]
}

model Profile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  firstName       String?
  lastName        String?
  phone           String?
  profileImageUrl String?
  bio             String?   @db.Text
  gender          Gender?
  birthdate       DateTime?
  occupation      String?
  currentAddress  String?
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OwnerApplication {
  id           Int               @id @default(autoincrement())
  userId       Int
  reviewedById Int?
  status       ApplicationStatus @default(PENDING)
  documentUrl  String?
  rejectReason String?
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?

  user       User  @relation("OwnerApplicationUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("OwnerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model Property {
  id             Int            @id @default(autoincrement())
  ownerId        Int
  title          String
  description    String         @db.Text
  propertyType   PropertyType
  rentType       RentType
  monthlyRent    Decimal        @db.Decimal(10, 2)
  deposit        Decimal?       @db.Decimal(10, 2)
  availableDate  DateTime?
  totalBedrooms  Int?
  publishStatus  PublishStatus  @default(PENDING)
  propertyStatus PropertyStatus @default(AVAILABLE)
  rejectReason   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  address PropertyAddress?
  rooms   Room[]
  images  PropertyImage[]

  communityPosts CommunityPost[]
  conversations  Conversation[]
  rentals        Rental[]
}

model PropertyAddress {
  id          Int      @id @default(autoincrement())
  propertyId  Int      @unique
  province    String
  district    String?
  subDistrict String?
  postcode    String?
  road        String?
  building    String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Room {
  id          Int        @id @default(autoincrement())
  propertyId  Int
  roomName    String
  description String?    @db.Text
  monthlyRent Decimal    @db.Decimal(10, 2)
  status      RoomStatus @default(AVAILABLE)
  capacity    Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  rentals Rental[]
}

model PropertyImage {
  id         Int      @id @default(autoincrement())
  propertyId Int
  imageUrl   String
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model CommunityPost {
  id              Int                 @id @default(autoincrement())
  propertyId      Int
  creatorId       Int
  title           String
  description     String?             @db.Text
  requiredMembers Int
  status          CommunityPostStatus @default(OPEN)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  joinRequests JoinRequest[]
  members      CommunityMember[]
}

model JoinRequest {
  id              Int               @id @default(autoincrement())
  communityPostId Int
  userId          Int
  status          JoinRequestStatus @default(PENDING)
  message         String?           @db.Text
  createdAt       DateTime          @default(now())
  reviewedAt      DateTime?

  communityPost CommunityPost @relation(fields: [communityPostId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityPostId, userId])
}

model CommunityMember {
  communityPostId Int
  userId          Int
  memberRole      CommunityMemberRole @default(MEMBER)
  joinedAt        DateTime            @default(now())

  communityPost CommunityPost @relation(fields: [communityPostId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityPostId, userId])
}

model Conversation {
  id         Int      @id @default(autoincrement())
  propertyId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId Int
  userId         Int
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  message        String   @db.Text
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Rental {
  id          Int          @id @default(autoincrement())
  propertyId  Int
  roomId      Int?
  ownerId     Int
  startDate   DateTime
  endDate     DateTime?
  monthlyRent Decimal      @db.Decimal(10, 2)
  status      RentalStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  owner User @relation("RentalOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members RentalMember[]
}

model RentalMember {
  rentalId Int
  userId   Int
  joinedAt DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([rentalId, userId])
}
