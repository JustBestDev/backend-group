{
  "info": {
    "_postman_id": "78b26472-acde-4b92-9acf-42b5762af253",
    "name": "Backend Group - Property API",
    "description": "End-to-end Property API tests: owner creates and edits a property, admin approves it, public endpoints retrieve it, and the owner soft-deletes it for cleanup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "ownerEmail", "value": "owner@example.com" },
    { "key": "ownerPassword", "value": "password123", "type": "secret" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "password123", "type": "secret" },
    { "key": "ownerToken", "value": "", "type": "secret" },
    { "key": "adminToken", "value": "", "type": "secret" },
    { "key": "propertyId", "value": "" },
    { "key": "roomId", "value": "" },
    { "key": "imageId", "value": "" },
    { "key": "propertyTitle", "value": "Postman Test Property" },
    { "key": "province", "value": "Bangkok" }
  ],
  "item": [
    {
      "name": "01 - Login as owner",
      "auth": { "type": "noauth" },
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.test('Logged-in user is OWNER', () => { pm.expect(json.token).to.be.a('string').and.not.empty; pm.expect(json.user.role).to.eql('OWNER'); });",
        "if (json.token) pm.collectionVariables.set('ownerToken', json.token);"
      ] } }]
    },
    {
      "name": "02 - Create property",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{propertyTitle}}\",\n  \"description\": \"Property created by the Postman test collection\",\n  \"propertyType\": \"CONDO\",\n  \"rentType\": \"WHOLE_UNIT\",\n  \"monthlyRent\": 15000,\n  \"deposit\": 30000,\n  \"availableDate\": \"2026-10-01\",\n  \"totalBedrooms\": 2\n}"
        },
        "url": "{{baseUrl}}/api/properties"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 201', () => pm.response.to.have.status(201));",
        "const json = pm.response.json();",
        "pm.test('Property is created as PENDING', () => { pm.expect(json.data.id).to.be.a('number'); pm.expect(json.data.publishStatus).to.eql('PENDING'); pm.expect(json.data.rentType).to.eql('WHOLE_UNIT'); });",
        "if (json.data?.id) pm.collectionVariables.set('propertyId', json.data.id);"
      ] } }]
    },
    {
      "name": "03 - Create property address",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"province\": \"{{province}}\",\n  \"district\": \"Pathum Wan\",\n  \"subDistrict\": \"Lumphini\",\n  \"postcode\": \"10330\",\n  \"road\": \"Rama I Road\",\n  \"building\": \"Postman Building\",\n  \"latitude\": 13.7466,\n  \"longitude\": 100.5393\n}" },
        "url": "{{baseUrl}}/api/properties/{{propertyId}}/address"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 201', () => pm.response.to.have.status(201));",
        "const json = pm.response.json();",
        "pm.test('Address belongs to created property', () => { pm.expect(json.data.propertyId).to.eql(Number(pm.collectionVariables.get('propertyId'))); pm.expect(json.data.province).to.eql(pm.collectionVariables.get('province')); });"
      ] } }]
    },
    {
      "name": "04 - Update property",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated by Postman automated test\",\n  \"monthlyRent\": 16000\n}" },
        "url": "{{baseUrl}}/api/properties/{{propertyId}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.test('Fields are updated and review returns to PENDING', () => { pm.expect(Number(json.data.monthlyRent)).to.eql(16000); pm.expect(json.data.publishStatus).to.eql('PENDING'); });"
      ] } }]
    },
    {
      "name": "05 - Update property address",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"road\": \"Updated Rama I Road\",\n  \"building\": \"Updated Postman Building\"\n}" },
        "url": "{{baseUrl}}/api/properties/{{propertyId}}/address"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Address is updated', () => pm.expect(pm.response.json().data.building).to.eql('Updated Postman Building'));"
      ] } }]
    },
    {
      "name": "06 - Get my properties",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
      "request": { "method": "GET", "url": "{{baseUrl}}/api/properties/me" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.test('Created property is present', () => { const found = json.data.find(item => item.id === Number(pm.collectionVariables.get('propertyId'))); pm.expect(found).to.exist; pm.expect(found.address).to.exist; });"
      ] } }]
    },
    {
      "name": "07 - Owner gets pending property by ID",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
      "request": { "method": "GET", "url": "{{baseUrl}}/api/properties/{{propertyId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.test('Owner can see own PENDING property', () => { pm.expect(json.data.id).to.eql(Number(pm.collectionVariables.get('propertyId'))); pm.expect(json.data.publishStatus).to.eql('PENDING'); });"
      ] } }]
    },
    {
      "name": "08 - Set property CLOSED",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"propertyStatus\": \"CLOSED\"\n}" },
        "url": "{{baseUrl}}/api/properties/{{propertyId}}/status"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Property becomes CLOSED', () => pm.expect(pm.response.json().data.propertyStatus).to.eql('CLOSED'));"
      ] } }]
    },
    {
      "name": "09 - Set property AVAILABLE",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"propertyStatus\": \"AVAILABLE\"\n}" },
        "url": "{{baseUrl}}/api/properties/{{propertyId}}/status"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Property becomes AVAILABLE', () => pm.expect(pm.response.json().data.propertyStatus).to.eql('AVAILABLE'));"
      ] } }]
    },
    {
      "name": "10 - Login as admin",
      "auth": { "type": "noauth" },
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.test('Logged-in user is ADMIN', () => { pm.expect(json.token).to.be.a('string').and.not.empty; pm.expect(json.user.role).to.eql('ADMIN'); });",
        "if (json.token) pm.collectionVariables.set('adminToken', json.token);"
      ] } }]
    },
    {
      "name": "11 - Admin approves property",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"publishStatus\": \"APPROVED\"\n}" },
        "url": "{{baseUrl}}/api/admin/properties/{{propertyId}}/publish-status"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Property becomes APPROVED', () => pm.expect(pm.response.json().data.publishStatus).to.eql('APPROVED'));"
      ] } }]
    },
    {
      "name": "12 - Public lists approved properties",
      "auth": { "type": "noauth" },
      "request": { "method": "GET", "url": "{{baseUrl}}/api/properties?q=Postman&province={{province}}&propertyType=CONDO&rentType=WHOLE_UNIT&propertyStatus=AVAILABLE&minRent=10000&maxRent=20000&page=1&limit=10" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.test('Pagination and filters return approved property', () => { pm.expect(json.pagination.page).to.eql(1); const found = json.data.find(item => item.id === Number(pm.collectionVariables.get('propertyId'))); pm.expect(found).to.exist; pm.expect(found.publishStatus).to.eql('APPROVED'); });"
      ] } }]
    },
    {
      "name": "13 - Public gets approved property by ID",
      "auth": { "type": "noauth" },
      "request": { "method": "GET", "url": "{{baseUrl}}/api/properties/{{propertyId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "const json = pm.response.json();",
        "pm.test('Public receives the approved property', () => { pm.expect(json.data.id).to.eql(Number(pm.collectionVariables.get('propertyId'))); pm.expect(json.data.publishStatus).to.eql('APPROVED'); });"
      ] } }]
    },
    {
      "name": "14 - Delete property (cleanup)",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/properties/{{propertyId}}", "description": "Soft-deletes the property created by this collection and changes its propertyStatus to CLOSED." },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Deleted ID matches test property', () => pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('propertyId'))));"
      ] } }]
    },
    {
      "name": "15 - Deleted property is hidden",
      "auth": { "type": "noauth" },
      "request": { "method": "GET", "url": "{{baseUrl}}/api/properties/{{propertyId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 404', () => pm.response.to.have.status(404));"
      ] } }]
    },
    {
      "name": "Manual / optional tests",
      "item": [
        {
          "name": "Upload property images",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "images", "type": "file", "src": [] }] },
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/images",
            "description": "Select 1-5 JPEG, PNG, WebP, or GIF files (maximum 5 MB each). Run before admin approval and cleanup. Requires Cloudinary environment variables."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
            "const json = pm.response.json();",
            "pm.test('Uploaded image list is returned', () => pm.expect(json.data).to.be.an('array').that.is.not.empty);",
            "if (json.data?.[0]?.id) pm.collectionVariables.set('imageId', json.data[0].id);"
          ] } }]
        },
        {
          "name": "Delete property image",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/properties/{{propertyId}}/images/{{imageId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Create room",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] },
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"roomName\": \"Room A\",\n  \"description\": \"Postman test room\",\n  \"monthlyRent\": 8000,\n  \"status\": \"AVAILABLE\",\n  \"capacity\": 2\n}" },
            "url": "{{baseUrl}}/api/properties/{{propertyId}}/rooms",
            "description": "Use with an INDIVIDUAL_ROOM property before cleanup."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('Room is created', () => pm.expect(json.data.id).to.be.a('number'));",
            "if (json.data?.id) pm.collectionVariables.set('roomId', json.data.id);"
          ] } }]
        },
        {
          "name": "Get available rooms (public)",
          "auth": { "type": "noauth" },
          "request": { "method": "GET", "url": "{{baseUrl}}/api/properties/{{propertyId}}/rooms", "description": "Property must be APPROVED." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Response contains rooms array', () => pm.expect(pm.response.json().data.rooms).to.be.an('array'));"
          ] } }]
        },
        {
          "name": "Reject invalid property ID",
          "auth": { "type": "noauth" },
          "request": { "method": "GET", "url": "{{baseUrl}}/api/properties/not-a-number" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        }
      ]
    }
  ]
}
